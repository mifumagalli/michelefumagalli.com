---
import { SITE, orcidUrl } from '../lib/site';

interface Props {
  /** "center" under the portrait, "start" when the layout is stacked. */
  align?: 'center' | 'start';
}

const { align = 'center' } = Astro.props;

// SITE.email is stored with spaces around the @ to slow down scrapers;
// strip them for the mailto: link.
const mailto = `mailto:${SITE.email.replace(/\s+/g, '')}`;

const links = [
  { key: 'email', href: mailto, label: 'Email', external: false },
  { key: 'github', href: SITE.github, label: 'GitHub', external: true },
  { key: 'orcid', href: orcidUrl, label: 'ORCID profile', external: true },
  { key: 'linkedin', href: SITE.linkedin, label: 'LinkedIn', external: true },
].filter((l) => !!l.href);
---

<ul class:list={['social', align]}>
  {
    links.map((l) => (
      <li>
        <a
          href={l.href}
          aria-label={l.label}
          title={l.label}
          {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {l.key === 'email' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M1.5 5.25A2.25 2.25 0 0 1 3.75 3h16.5a2.25 2.25 0 0 1 2.25 2.25v.34L12 12.19 1.5 5.59v-.34Z" />
              <path d="M22.5 7.36V18.75A2.25 2.25 0 0 1 20.25 21H3.75A2.25 2.25 0 0 1 1.5 18.75V7.36l9.94 6.25c.34.22.78.22 1.12 0L22.5 7.36Z" />
            </svg>
          )}

          {l.key === 'github' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.65.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.81 1.1.81 2.22 0 1.61-.01 2.9-.01 3.3 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12.5C24 5.87 18.63.5 12 .5Z" />
            </svg>
          )}

          {l.key === 'orcid' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="12" />
              <g class="knockout">
                <rect x="6.6" y="8.9" width="1.8" height="8.3" rx="0.2" />
                <circle cx="7.5" cy="6.8" r="1.15" />
                <path d="M10.7 8.9h4.05c3.2 0 4.75 2.05 4.75 4.15 0 2.23-1.74 4.15-4.73 4.15H10.7V8.9Zm1.8 6.65h2.06c1.98 0 2.9-1.06 2.9-2.5 0-1.32-.84-2.5-2.9-2.5H12.5v5Z" />
              </g>
            </svg>
          )}

          {l.key === 'linkedin' && (
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0Z" />
            </svg>
          )}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 1.35rem 0 0;
    max-width: none;
  }

  .social.center { justify-content: center; }
  .social.start { justify-content: flex-start; margin-left: -0.4rem; }

  li { margin: 0; }

  a {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    color: var(--muted);
    text-decoration: none;
    transition: color 140ms ease, background 140ms ease;
  }

  a:hover {
    color: var(--accent);
    background: var(--accent-soft);
  }

  svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
    display: block;
  }

  /* The ORCID mark is a filled disc with the "iD" knocked out of it. */
  .knockout { fill: var(--bg); }
</style>
