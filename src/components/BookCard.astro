---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  subtitle?: string;
  authors?: string;
  publisher?: string;
  year?: number;
  cover?: ImageMetadata;
  synopsis: string;
  isbn?: string;
  language?: string;
  age?: string;
  links?: readonly { label: string; href: string }[];
}

const {
  title,
  subtitle,
  authors,
  publisher,
  year,
  cover,
  synopsis,
  isbn,
  language,
  age,
  links = [],
} = Astro.props;

// "with A. Author · Cambridge University Press · 2025"
const meta = [authors, publisher, year].filter(Boolean).join(' · ');

// "ISBN 979-12-8196-649-9 · Italian · Ages 7+"
const details = [isbn && `ISBN ${isbn}`, language, age && `Ages ${age}`]
  .filter(Boolean)
  .join(' · ');
const isExternal = (href: string) => /^https?:\/\//i.test(href);
---

<article class:list={['book', { hascover: !!cover }]}>
  {
    cover && (
      <div class="cover">
        <Image src={cover} alt={`Cover of ${title}`} widths={[180, 360]} sizes="90px" />
      </div>
    )
  }

  <div class="body">
    <h3>{title}</h3>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    {meta && <p class="meta">{meta}</p>}
    <p class="synopsis">{synopsis}</p>
    {details && <p class="meta details">{details}</p>}
    {
      links.length > 0 && (
        <p class="links">
          {links.map((l) => (
            <a
              href={l.href}
              {...(isExternal(l.href)
                ? { target: '_blank', rel: 'noopener noreferrer' }
                : {})}
            >
              {l.label}
            </a>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .book {
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    max-width: var(--measure);
    margin-bottom: 1rem;
  }

  .book.hascover {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    gap: 1.3rem;
    align-items: start;
  }

  .cover {
    aspect-ratio: 2 / 3;
    overflow: hidden;
    border-radius: 2px;
    /* A book needs to read as an object, so give it a little lift. */
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.14), 0 6px 14px rgba(0, 0, 0, 0.08);
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  h3 {
    margin: 0 0 0.2rem;
    font-size: 1.08rem;
    line-height: 1.25;
  }

  .subtitle {
    margin: 0 0 0.3rem;
    font-size: 0.95em;
    color: var(--text);
    max-width: none;
  }

  .meta { margin: 0 0 0.55rem; max-width: none; }

  /* Same treatment as the author/publisher line, but it sits below the
     synopsis, so the margin flips to the top. */
  .details { margin: 0.55rem 0 0; }

  .synopsis {
    margin: 0;
    color: var(--muted);
    font-size: 0.93em;
    max-width: none;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0.7rem 0 0;
    font-family: var(--sans);
    font-size: 0.78rem;
    max-width: none;
  }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }

  @media (max-width: 520px) {
    .book.hascover { grid-template-columns: 72px minmax(0, 1fr); gap: 1rem; }
  }
</style>
