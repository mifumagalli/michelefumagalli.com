---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  summary: string;
  date: Date;
  tags?: readonly string[];
  image?: ImageMetadata;
  /** "lead" gives the first card a wide image above the text. */
  variant?: 'lead' | 'row';
}

const { href, title, summary, date, tags = [], image, variant = 'row' } = Astro.props;
const label = date.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
const iso = date.toISOString().slice(0, 10);
const isLead = variant === 'lead';
---

<article class:list={['card', variant, { hasimg: !!image }]}>
  {
    image && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <Image
          src={image}
          alt=""
          widths={isLead ? [640, 1000] : [200, 400]}
          sizes={isLead ? '(max-width: 700px) 100vw, 640px' : '104px'}
        />
      </a>
    )
  }

  <div class="text">
    <p class="meta"><time datetime={iso}>{label}</time></p>
    <h3><a href={href}>{title}</a></h3>
    <p class="summary">{summary}</p>
    {
      tags.length > 0 && (
        <p class="tags">
          {tags.map((t) => (
            <span class="tag">{t}</span>
          ))}
        </p>
      )
    }
  </div>
</article>

<style>
  .card {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .card :global(h3) {
    margin: 0.15rem 0 0.45rem;
    font-size: 1.12rem;
    line-height: 1.3;
  }

  .card :global(h3 a) { color: var(--text); text-decoration: none; }
  .card :global(h3 a:hover) { color: var(--accent); }

  .summary { margin: 0; color: var(--muted); font-size: 0.95em; max-width: none; }
  .meta { margin: 0; }
  .tags { margin: 0.7rem 0 0; max-width: none; }

  .thumb { display: block; overflow: hidden; border-radius: var(--radius); }
  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 400ms ease;
  }
  .card:hover .thumb :global(img) { transform: scale(1.03); }

  /* Lead card: wide image above the text, on a tinted panel. */
  .lead {
    border-bottom: none;
    padding: 0;
    margin-top: 1.6rem;
    margin-bottom: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .lead .thumb { border-radius: 0; aspect-ratio: 16 / 7; }
  .lead .text { padding: 1.25rem 1.4rem 1.5rem; }
  .lead :global(h3) { font-size: 1.32rem; }

  /* Row card: square thumbnail beside the text. */
  .row.hasimg {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 1.1rem;
    align-items: start;
  }
  .row .thumb { aspect-ratio: 1 / 1; }

  @media (max-width: 520px) {
    .row.hasimg { grid-template-columns: 76px minmax(0, 1fr); gap: 0.9rem; }
    .lead .thumb { aspect-ratio: 16 / 9; }
  }
</style>
