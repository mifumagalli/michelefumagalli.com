---
import type { Repo } from '../lib/publications';

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
const pushed = new Date(repo.pushedAt).toLocaleDateString('en-GB', {
  month: 'short',
  year: 'numeric',
});
---

<article class="repo">
  <h3><a href={repo.url}>{repo.name}</a></h3>
  {repo.description && <p class="desc">{repo.description}</p>}
  {repo.note && <p class="note">{repo.note}</p>}
  <p class="meta facts">
    {repo.language && <span>{repo.language}</span>}
    {repo.stars > 0 && <span>{repo.stars} ★</span>}
    <span>updated {pushed}</span>
    {repo.homepage && <a href={repo.homepage}>docs</a>}
  </p>
</article>

<style>
  .repo {
    padding: 1.15rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .repo :global(h3) {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-family: var(--mono);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .repo :global(h3 a) { color: var(--text); text-decoration: none; }
  .repo :global(h3 a:hover) { color: var(--accent); }

  .desc { margin: 0 0 0.4rem; font-size: 0.92em; color: var(--muted); max-width: none; }

  .note {
    margin: 0 0 0.5rem;
    font-size: 0.9em;
    max-width: none;
    padding-left: 0.7rem;
    border-left: 2px solid var(--accent);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0;
    font-size: 0.78rem;
  }
</style>
