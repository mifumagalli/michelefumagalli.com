---
import Base from '../layouts/Base.astro';
import { SITE, orcidUrl, adsSearchUrl } from '../lib/site';

const elsewhere = [
  { label: 'ORCID', note: SITE.orcid, href: orcidUrl },
  { label: 'Curriculum vitae', note: 'PDF', href: SITE.cv },
  { label: 'GitHub', note: SITE.githubUser, href: SITE.github },
  { label: 'LinkedIn', note: 'Profile', href: SITE.linkedin },
  { label: 'NASA ADS', note: 'Full publication list', href: adsSearchUrl },
].filter((l) => !!l.href);
---

<Base
  title="Contact"
  description="How to reach Michele Fumagalli at the University of Milano-Bicocca."
>
  <p class="eyebrow">Contact</p>
  <h1>Get in touch</h1>

  <p class="lede">
    My department page is the best place to start — it carries my current
    email address, telephone number and office hours, and the university keeps
    it up to date rather than me.
  </p>

  <a class="cta" href={SITE.universityProfile} target="_blank" rel="noopener noreferrer">
    <span class="cta-text">
      <span class="cta-eyebrow">University profile</span>
      <span class="cta-title">Università degli Studi di Milano-Bicocca</span>
      <span class="cta-note">Email, telephone, office and appointments</span>
    </span>
    <span class="cta-arrow" aria-hidden="true">→</span>
  </a>

  <div class="cols">
    <section>
      <h2>Where to find me</h2>
      <address>
        {SITE.affiliation}<br />
        {SITE.address.map((line) => <>{line}<br /></>)}
      </address>
      <p class="office">{SITE.office}</p>
    </section>

    <section>
      <h2>Elsewhere</h2>
      <ul class="elsewhere">
        {
          elsewhere.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="noopener noreferrer">
                {l.label}
              </a>
              <span class="note">{l.note}</span>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

<style>
  h1 { margin-bottom: 0.4em; }
  .lede { margin-bottom: 2rem; max-width: 34em; }

  /* ---------- primary call to action ---------- */

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    max-width: var(--measure);
    padding: 1.35rem 1.5rem;
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .cta:hover {
    border-color: var(--accent);
    border-left-color: var(--accent);
    transform: translateY(-1px);
  }

  .cta-text { display: flex; flex-direction: column; gap: 0.22rem; }

  .cta-eyebrow {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 620;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .cta-title {
    font-family: var(--sans);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.012em;
    line-height: 1.25;
  }

  .cta-note {
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }

  .cta-arrow {
    font-size: 1.15rem;
    color: var(--accent);
    flex: none;
    transition: transform 150ms ease;
  }
  .cta:hover .cta-arrow { transform: translateX(3px); }

  /* ---------- two columns ---------- */

  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 2rem 2.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    max-width: var(--measure);
  }

  h2 {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 620;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 0.9rem;
  }

  address {
    font-style: normal;
    line-height: 1.7;
    font-size: 0.97em;
    margin: 0;
  }

  .office {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: var(--muted);
    margin: 0.85rem 0 0;
    max-width: none;
  }

  .elsewhere {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: none;
  }

  .elsewhere li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    margin: 0;
  }
  .elsewhere li:first-child { padding-top: 0; }

  .elsewhere a {
    font-family: var(--sans);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .elsewhere a:hover { text-decoration: underline; }

  .note {
    font-family: var(--sans);
    font-size: 0.74rem;
    color: var(--faint);
    text-align: right;
    white-space: nowrap;
  }
</style>
