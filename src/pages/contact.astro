---
import Base from '../layouts/Base.astro';
import { SITE, orcidUrl } from '../lib/site';
---

<Base title="Contact" description="How to reach Michele Fumagalli.">
  <p class="eyebrow">Contact</p>
  <h1>Get in touch</h1>

  <address>
    {SITE.affiliation}<br />
    {SITE.address.map((line) => <>{line}<br /></>)}
  </address>

  <p class="email">
    <a href={`mailto:${SITE.email.replace(/\s+/g, '')}`}>{SITE.email}</a>
  </p>

  <p class="meta links">
    <a href={orcidUrl} target="_blank" rel="noopener noreferrer">ORCID {SITE.orcid}</a>
    <a href={SITE.cv} target="_blank" rel="noopener noreferrer">Curriculum vitae</a>
  </p>
</Base>

<style>
  address {
    font-style: normal;
    line-height: 1.75;
    margin-bottom: 1.8rem;
  }

  .links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.4rem; max-width: none; }
  .links a { text-decoration: none; }
  .links a:hover { text-decoration: underline; }

  .email {
    font-size: 1.05em;
    margin-bottom: 1.4rem;
  }
</style>
