---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { getProjects } from '../lib/content';

const projects = await getProjects();
---

<Base
  title="Research"
  description="Galaxy evolution, the circumgalactic medium, and the exchange of gas between galaxies and their surroundings."
>
  <p class="eyebrow">Research</p>
  <h1>Gas in and around galaxies</h1>

  <p class="lede">
    Galaxies do not form stars in isolation. They draw gas in from their
    surroundings and expel it again, and the balance between those flows sets
    how much star formation is possible.
  </p>

  <p>
    My group studies that exchange directly — the diffuse gas in the
    circumgalactic medium, how it is enriched with metals, how it moves, and
    how it connects galaxies to the cosmic web they sit in. Because this gas is
    far too faint to image in most circumstances, we work largely through the
    absorption it imprints on background light, and through the rare cases
    where it can be seen in emission.
  </p>

  <p>
    The work combines deep integral-field spectroscopy — principally with MUSE
    on the VLT — with space-based imaging and with cosmological simulations
    that let us ask what a given observation should have looked like.
  </p>

  {
    projects.length > 0 && (
      <section class="projects">
        <h2>Current projects</h2>
        {projects.map((p) => (
          <ProjectRow
            title={p.data.title}
            short={p.data.short}
            role={p.data.role}
            period={p.data.period}
            image={p.data.image}
            summary={p.data.summary}
            links={p.data.links}
          />
        ))}
      </section>
    )
  }
</Base>

<style>
  .projects { margin-top: clamp(2.75rem, 6vw, 4rem); }

  .projects h2 {
    margin-top: 0;
    margin-bottom: 0.4rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    max-width: var(--measure);
    font-size: 1.15rem;
  }
</style>
