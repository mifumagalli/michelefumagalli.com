---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HighlightCard from '../components/HighlightCard.astro';
import { getHighlights } from '../lib/content';
import { publications } from '../lib/publications';
import { SITE, adsSearchUrl, orcidUrl } from '../lib/site';
import portrait from '../assets/portrait.jpg';

const highlights = await getHighlights();
const [lead, ...rest] = highlights.slice(0, 3);
const pubCount = publications.length;
---

<Base>
  <section class="hero">
    <div class="intro">
      <p class="eyebrow">Astrophysicist · University of Milano-Bicocca</p>
      <h1>Michele Fumagalli</h1>
      <p class="lede">
        I study how galaxies evolve and form stars by exchanging gas with
        their surroundings.
      </p>
      <p class="body">
        My group works on the diffuse gas around galaxies — how it flows in,
        how it is expelled, and how it connects galaxies to the cosmic web.
        We combine deep integral-field spectroscopy with cosmological
        simulations.
      </p>
      <p class="quick">
        <a href={adsSearchUrl} target="_blank" rel="noopener noreferrer">Publications on ADS</a>
        <a href={SITE.cv} target="_blank" rel="noopener noreferrer">Curriculum vitae</a>
        <a href={orcidUrl} target="_blank" rel="noopener noreferrer">ORCID</a>
      </p>
    </div>

    <figure class="portrait">
      <Image src={portrait} alt="Michele Fumagalli" widths={[230, 460]} sizes="230px" />
    </figure>
  </section>

  <nav class="tiles" aria-label="Sections">
    <a href="/publications">
      <span class="tile-label">Publications</span>
      <span class="tile-note">{pubCount} indexed on ADS</span>
    </a>
    <a href="/highlights">
      <span class="tile-label">Highlights</span>
      <span class="tile-note">Papers in plain language</span>
    </a>
    <a href="/code">
      <span class="tile-label">Data &amp; Code</span>
      <span class="tile-note">Public software and products</span>
    </a>
  </nav>

  {
    lead && (
      <section class="recent">
        <div class="head">
          <h2>Recent highlights</h2>
          <a class="meta more" href="/highlights">All highlights →</a>
        </div>

        <HighlightCard
          href={`/highlights/${lead.id}`}
          title={lead.data.title}
          summary={lead.data.summary}
          date={lead.data.date}
          tags={lead.data.tags}
          image={lead.data.figure}
          variant="lead"
        />

        {rest.map((h) => (
          <HighlightCard
            href={`/highlights/${h.id}`}
            title={h.data.title}
            summary={h.data.summary}
            date={h.data.date}
            tags={h.data.tags}
            image={h.data.figure}
          />
        ))}
      </section>
    )
  }
</Base>

<style>
  /* ---------- hero ---------- */

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 230px;
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
    position: relative;
    padding-bottom: 0.5rem;
  }

  /* Soft accent glow behind the portrait — the only decorative flourish. */
  .hero::before {
    content: '';
    position: absolute;
    top: -12%;
    right: -14%;
    width: 26rem;
    height: 26rem;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--accent) 13%, transparent) 0%,
      transparent 68%
    );
    z-index: -1;
    pointer-events: none;
  }

  .intro h1 {
    font-size: clamp(2.1rem, 1.4rem + 2.8vw, 3.1rem);
    margin-bottom: 0.4em;
  }

  .lede {
    font-size: 1.16em;
    line-height: 1.5;
    color: var(--text);
    margin-bottom: 0.9em;
    max-width: 22em;
  }

  .body {
    color: var(--muted);
    max-width: 32em;
  }

  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.6rem;
    font-family: var(--sans);
    font-size: 0.87rem;
    max-width: none;
  }
  .quick a { text-decoration: none; }
  .quick a:hover { text-decoration: underline; }

  /* ---------- circular portrait with accent ring ---------- */

  .portrait {
    margin: 0.5rem 0 0;
    position: relative;
    width: 230px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
  }

  .portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    position: relative;
    z-index: 1;
  }

  /* Concentric accent ring, sitting just outside the photo. */
  .portrait::after {
    content: '';
    position: absolute;
    inset: -13px;
    border: 1px solid var(--accent);
    border-radius: 50%;
    opacity: 0.45;
    z-index: 0;
  }

  /* ---------- three section tiles ---------- */

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.75rem;
    margin-top: clamp(2.5rem, 6vw, 3.75rem);
    max-width: var(--measure);
  }

  .tiles a {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.95rem 1.05rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    text-decoration: none;
    background: var(--bg);
    transition: border-color 140ms ease, background 140ms ease, transform 140ms ease;
  }

  .tiles a:hover {
    border-color: var(--accent);
    background: var(--surface);
    transform: translateY(-1px);
  }

  .tile-label {
    font-family: var(--sans);
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    letter-spacing: -0.008em;
  }

  .tile-note {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* ---------- recent highlights ---------- */

  .recent { margin-top: clamp(3rem, 7vw, 4.5rem); }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    max-width: var(--measure);
  }

  .head h2 { margin: 0; font-size: 1.15rem; }
  .more { text-decoration: none; white-space: nowrap; font-size: 0.83rem; }
  .more:hover { text-decoration: underline; }

  /* ---------- narrow screens ---------- */

  @media (max-width: 640px) {
    .hero { grid-template-columns: 1fr; }
    .portrait {
      width: 132px;
      order: -1;
      margin-bottom: 1.5rem;
    }
    .portrait::after { inset: -9px; }
    .hero::before { display: none; }
  }
</style>
