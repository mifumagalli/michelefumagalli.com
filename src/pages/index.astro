---
import Base from '../layouts/Base.astro';
import HighlightCard from '../components/HighlightCard.astro';
import { getHighlights } from '../lib/content';
import { SITE, adsSearchUrl, orcidUrl } from '../lib/site';

const highlights = (await getHighlights()).slice(0, 3);
---

<Base>
  <section class="hero">
    <h1>Michele Fumagalli</h1>
    <p class="lede">
      Astrophysicist and professor in the Physics Department of the{' '}
      <a href="https://www.unimib.it">University of Milano-Bicocca</a>.
    </p>
    <p>
      I study how galaxies evolve and form stars by exchanging gas with their
      surroundings, using computer simulations alongside observations from the
      largest telescopes on the ground and in space.
    </p>
    <p class="quick meta">
      <a href={adsSearchUrl}>Publications on ADS</a>
      <a href="/cv.pdf">Curriculum vitae</a>
      <a href={orcidUrl}>ORCID {SITE.orcid}</a>
    </p>
  </section>

  {
    highlights.length > 0 && (
      <section class="recent">
        <div class="head">
          <h2>Recent highlights</h2>
          <a class="meta" href="/highlights">All highlights →</a>
        </div>
        {highlights.map((h) => (
          <HighlightCard
            href={`/highlights/${h.id}`}
            title={h.data.title}
            summary={h.data.summary}
            date={h.data.date}
            tags={h.data.tags}
          />
        ))}
      </section>
    )
  }
</Base>

<style>
  .hero h1 { margin-bottom: 0.35em; }
  .hero .lede { margin-bottom: 1.2em; }

  .quick {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: 1.8rem;
    max-width: none;
  }
  .quick a { text-decoration: none; }
  .quick a:hover { text-decoration: underline; }

  .recent { margin-top: 4rem; }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .head h2 { margin: 0 0 0.6rem; }
  .head a { text-decoration: none; white-space: nowrap; }
  .head a:hover { text-decoration: underline; }
</style>
